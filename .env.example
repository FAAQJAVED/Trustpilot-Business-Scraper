# .env.example — Trustpilot Business Scraper
# ==========================================
# This scraper does not require API keys or authentication credentials.
# All settings are managed through config.json.
#
# If you extend this tool to use third-party APIs (e.g. for email verification,
# enrichment services, or proxy rotation), add your keys below and load them
# in the relevant module using os.environ.get("YOUR_KEY_NAME").
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# NEVER commit your .env file to version control.
# Add it to .gitignore: echo ".env" >> .gitignore

# ── Example API key placeholders ──────────────────────────────────────────────
# Uncomment and populate if you add enrichment or proxy features.

# PROXY_API_KEY=YOUR_PROXY_SERVICE_API_KEY
# EMAIL_VERIFIER_API_KEY=YOUR_EMAIL_VERIFIER_KEY
# ENRICHMENT_API_KEY=YOUR_ENRICHMENT_SERVICE_KEY
